# --------------------------------------------------------------------------
# Provider switches (the only mandatory variables for local dev)
# --------------------------------------------------------------------------
# LLM_PROVIDER:   bedrock | vertex          (default: bedrock)
# SESSION_STORE:  local   | s3   | gcs      (default: local; USE_S3=true is honored as an alias for s3)
LLM_PROVIDER=bedrock
SESSION_STORE=local

# --------------------------------------------------------------------------
# Shared configuration
# --------------------------------------------------------------------------
PROJECT_NAME=customer-support-chatbot
MCP_SERVER_URL=https://order-mcp-74afyau24q-uc.a.run.app/mcp
CORS_ORIGINS=http://localhost:3000
MEMORY_DIR=../memory
NEXT_PUBLIC_API_URL=http://localhost:8000

# --------------------------------------------------------------------------
# AWS configuration (used when LLM_PROVIDER=bedrock or SESSION_STORE=s3)
# --------------------------------------------------------------------------
AWS_ACCOUNT_ID=your_12_digit_account_id
DEFAULT_AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
S3_BUCKET=

# --------------------------------------------------------------------------
# GCP configuration (used when LLM_PROVIDER=vertex or SESSION_STORE=gcs)
# --------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
VERTEX_MODEL_ID=gemini-2.5-flash
GCS_BUCKET=
FIREBASE_PROJECT_ID=your-firebase-project-id
